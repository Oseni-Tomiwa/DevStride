# Shared
APP_ENV=development

# Web
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_REALTIME_MAX_DURATION_SECONDS=3600
# Server-only HMAC secret for the app-level inactivity/absolute session policy.
# Set a long random value in the web deployment; never expose it as NEXT_PUBLIC_*.
SESSION_POLICY_SECRET=

# API
API_HOST=0.0.0.0
API_PORT=8000
DATABASE_URL=postgresql+asyncpg://devstride:devstride@localhost:5432/devstride
CORS_ORIGINS=http://localhost:3000
SUPABASE_JWT_ISSUER=https://<project-ref>.supabase.co/auth/v1
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_JWT_ALGORITHMS=ES256

# PostgreSQL container
POSTGRES_USER=devstride
POSTGRES_PASSWORD=devstride
POSTGRES_DB=devstride

# AI generation (backend only, disabled by default)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
AI_GENERATION_ENABLED=false
LIVE_INTERVIEW_ENABLED=false
LIVE_INTERVIEW_MODEL=gpt-realtime
VIDEO_INTERVIEW_ENABLED=false
LIVE_MENTOR_ENABLED=false
LIVE_MENTOR_MODEL=gpt-realtime
# In-process AI abuse protection. Use a distributed limiter before scaling out.
AI_RATE_LIMIT_ENABLED=true
AI_RATE_LIMIT_REQUESTS=20
AI_RATE_LIMIT_WINDOW_SECONDS=60
AI_RATE_LIMIT_KICKOFF_REQUESTS=5
AI_RATE_LIMIT_SUMMARY_REQUESTS=5
AI_CONCURRENCY_GLOBAL_LIMIT=10
AI_CONCURRENCY_USER_LIMIT=2
